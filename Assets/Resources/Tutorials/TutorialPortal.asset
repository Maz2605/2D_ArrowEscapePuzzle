  m_Script: {fileID: 11500000, guid: f5fb214434f7b5742862cd92d1eb165b, type: 3}
  m_Name: TutorialPortal
  m_EditorClassIdentifier: ArrowGame::ArrowGame.Data.LevelProvider.TutorialConfigSO
  levelID: Level_30
  handlerTypeName: 
  steps:
  - targetGridPos: {x: 9, y: 2}
    tooltipText: Portals with the same color are linked together! Tap anywhere to
      continue.
    showHandPointer: 0
    blockOutsideClick: 0
    hasSecondTarget: 1
    secondTargetGridPos: {x: 0, y: 11}
  - targetGridPos: {x: 8, y: 2}
    tooltipText: Tap this arrow! It will travel through the portal and escape.
    showHandPointer: 1
    blockOutsideClick: 1
    hasSecondTarget: 0
    secondTargetGridPos: {x: 0, y: 0}
  - targetGridPos: {x: 0, y: 10}
    tooltipText: The other arrow enters from the opposite side, but its exit is blocked!
      Try it.
    showHandPointer: 1
    blockOutsideClick: 1
    hasSecondTarget: 0
    secondTargetGridPos: {x: 0, y: 0}
